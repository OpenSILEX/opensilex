{
    "name": "opensilex-dataverse",
    "version": "0.1.0",
    "license":"AGPL-3.0-only", 
    "type": "module",
    "private": true,
    "main": "./dist/opensilex-dataverse.umd.min.js",
    "module": "./dist/opensilex-dataverse.umd.min.js",
    "exports": {
        ".": {
        "import": "./dist/opensilex-dataverse.umd.min.js"
        }
    },
    "scripts": {
        "dev:build": "vite build --config vite.config.ts --watch",
        "build": "vite build --config vite.config.ts",
        "lint": "vue-cli-service lint",
        "check:outdated": "npm outdated || cd ."
    },
    "devDependencies": {
        "vite": "^8.2.2"
    },
    "eslintConfig": {
        "root": true,
        "env": {
            "node": true
        },
        "extends": [
            "plugin:vue/essential",
            "eslint:recommended",
            "@vue/typescript"
        ],
        "rules": {
            "no-unused-vars": "off",
            "no-var": "off",
            "prefer-const": "off",
            "vue/custom-event-name-casing": "off",
            "vue/no-unused-vars": "off"
        },
        "parserOptions": {
            "parser": "@typescript-eslint/parser"
        }
    },
    "browserslist": [
        "> 1%",
        "last 2 versions"
    ]
}
